{
 "operations": {
  "POST /v1/speak": {
   "parameters": [
    {
     "name": "callback",
     "in": "query",
     "description": "URL to which we'll make the callback request",
     "required": false,
     "schema": {
      "type": "string"
     }
    },
    {
     "name": "callback_method",
     "in": "query",
     "description": "HTTP method by which the callback request will be made",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersCallbackMethod",
      "default": "POST"
     }
    },
    {
     "name": "mip_opt_out",
     "in": "query",
     "description": "Opts out requests from the Deepgram Model Improvement Program. Refer to our Docs for pricing impacts before setting this to true. https://dpgr.am/deepgram-mip",
     "required": false,
     "schema": {
      "type": "boolean",
      "default": false
     }
    },
    {
     "name": "tag",
     "in": "query",
     "description": "Label your requests for the purpose of identification during usage reporting",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersTag"
     }
    },
    {
     "name": "bit_rate",
     "in": "query",
     "description": "The bitrate of the audio in bits per second. Choose from predefined ranges or specific values based on the encoding type.",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersBitRate",
      "default": 48000
     }
    },
    {
     "name": "container",
     "in": "query",
     "description": "Container specifies the file format wrapper for the output audio. The available options depend on the encoding type.",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersContainer",
      "default": "wav"
     }
    },
    {
     "name": "encoding",
     "in": "query",
     "description": "Encoding allows you to specify the expected encoding of your audio output",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersEncoding",
      "default": "mp3"
     }
    },
    {
     "name": "model",
     "in": "query",
     "description": "AI model used to process submitted text",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersModel",
      "default": "aura-asteria-en"
     }
    },
    {
     "name": "sample_rate",
     "in": "query",
     "description": "Sample Rate specifies the sample rate for the output audio. Based on the encoding, different sample rates are supported. For some encodings, the sample rate is...",
     "required": false,
     "schema": {
      "$ref": "#/$defs/V1SpeakPostParametersSampleRate",
      "default": 24000
     }
    },
    {
     "name": "speed",
     "in": "query",
     "description": "Speaking rate multiplier that adjusts the pace of generated speech while preserving natural prosody and voice quality. Not yet supported in all languages.",
     "required": false,
     "schema": {
      "type": "number",
      "format": "double",
      "minimum": 0.7,
      "maximum": 1.5,
      "default": 1
     }
    }
   ],
   "requestBody": {
    "description": "Transform text to speech",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/$defs/SpeakV1Request"
      }
     }
    }
   },
   "responses": {
    "200": {
     "description": "Successful text-to-speech transformation",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/$defs/speak_v1_audio_generate_Response_200"
       }
      }
     }
    },
    "400": {
     "description": "Invalid Request",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/$defs/ErrorResponse"
       }
      }
     }
    }
   },
   "security": [
    {
     "ApiKeyAuth": []
    }
   ]
  },
