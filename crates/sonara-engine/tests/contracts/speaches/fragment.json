       }
      }
     }
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ]
  },
  "GET /v1/models": {
   "parameters": [
    {
     "name": "task",
     "in": "query",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "enum": [
         "automatic-speech-recognition",
         "text-to-speech",
         "speaker-embedding",
         "voice-activity-detection"
