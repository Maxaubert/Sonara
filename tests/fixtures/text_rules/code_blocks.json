      "fn": "assemble",
      "deltas": [
        "Here is code:\n```python\nprint('hi')\nx = 1\n```\nDone."
      ],
      "output": [
        "Here is code:",
        "Python code block, 2 lines.",
        "Done."
      ]
    },
    {
      "name": "fence_split_across_deltas",
      "fn": "assemble",
      "deltas": [
        "Before.\n``",
        "`js\nconst a = 1;\n",
        "```\nAfter."
      ],
      "output": [
        "Before.",
        "JavaScript code block, 1 line.",
        "After."
      ]
    },
    {
      "name": "fence_without_language",
      "fn": "assemble",
      "deltas": [
        "See:\n```\nls -la\n```\n"
      ],
      "output": [
        "See:",
        "Code block, 1 line."
      ]
    },
    {
      "name": "unclosed_fence_flushed_on_final",
      "fn": "assemble",
      "deltas": [
