#!/usr/bin/env bash
# Plugin hook launcher: run bin/sonara-hook <Event> on a REAL Python.
#
# hooks/hooks.json used to run bin/sonara-hook straight through its
# `#!/usr/bin/env python3` shebang. On Windows `python3` (and `python`) is the
# WindowsApps Store alias on PATH by default, which runs nothing, so a box whose
# only Python is python.org <= 3.13 or the one /sonara:install provisioned got
# no hooks at all (E3). Order: the interpreter the bootstrap recorded, then a
# PATH python3/python that is not the Store alias, then the py launcher.
# Uses shell builtins only, and always exits 0: a hook must never break the
# Claude session. stdin (the hook payload) passes through untouched.
here="$(cd "${0%/*}" 2>/dev/null && pwd)" || exit 0
hook="$here/sonara-hook"

py=""
rec="$HOME/.sonara/python.path"
if [ -f "$rec" ]; then
    IFS= read -r line < "$rec" || true
    line="${line#$'\xef\xbb\xbf'}"     # a BOM from older PowerShell records (M14)
    line="${line%$'\r'}"
    line="${line//\\//}"
    [ -n "$line" ] && [ -f "$line" ] && py="$line"
fi
if [ -z "$py" ]; then
    for name in python3 python; do
        cand="$(command -v "$name" 2>/dev/null)" || continue
        case "$cand" in
            *WindowsApps*|*windowsapps*) ;;   # the Store alias: runs nothing
            *) py="$cand"; break ;;
        esac
    done
fi
if [ -n "$py" ]; then
    "$py" "$hook" "$@"
elif command -v py >/dev/null 2>&1; then
    py -3 "$hook" "$@"
fi
exit 0
