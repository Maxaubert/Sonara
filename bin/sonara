#!/usr/bin/env bash
# The plugin's slash commands run `bin/sonara <command>` (#202): sonara.exe
# of the runtime this plugin version needs (bin/runtime-version), from
# %LOCALAPPDATA%\Sonara\runtime\<version>\. When it is missing, the
# runtime is installed first, in the foreground, with
# bin/sonara-bootstrap.ps1 (download, SHA-256 check, install).
here="$(cd "${0%/*}" 2>/dev/null && pwd)" || here="${0%/*}"
ver=""
{ IFS= read -r ver < "$here/runtime-version"; } 2>/dev/null
ver="${ver%$'\r'}"
lad="${LOCALAPPDATA//\//}"
if [ -z "$ver" ] || [ -z "$lad" ]; then
    echo "Sonara: cannot find bin/runtime-version or LOCALAPPDATA." >&2
    exit 1
fi
root="$lad/Sonara/runtime"
exe="$root/$ver/sonara.exe"
# `sonara doctor` checks the plugin's hooks; a slash command's Bash tool may
# not have the variable set.
if [ -z "$CLAUDE_PLUGIN_ROOT" ]; then
    CLAUDE_PLUGIN_ROOT="${here%/*}"
    if command -v cygpath >/dev/null 2>&1; then
        CLAUDE_PLUGIN_ROOT="$(cygpath -w "$CLAUDE_PLUGIN_ROOT")"
    fi
    export CLAUDE_PLUGIN_ROOT
fi
if [ ! -f "$exe" ]; then
    if [ "$1" = "uninstall" ] || [ "$1" = "stop" ]; then
        echo "Sonara's runtime $ver is not installed: nothing to $1."
        exit 0
    fi
    echo "Installing the Sonara runtime $ver (about 15 MB) from GitHub..."
    mkdir -p "$root" || exit 1
    lock="$root/.bootstrap.lock"
    # A hook may be installing it already: wait for it (up to 5 minutes).
    waited=0
    own=""
    while [ ! -f "$exe" ]; do
        if mkdir "$lock" 2>/dev/null; then
            own=1
            break
        fi
        if [ "$waited" -ge 300 ]; then
            rm -rf "$lock"
            waited=0
            continue
        fi
        sleep 1
        waited=$((waited + 1))
    done
    if [ -n "$own" ] && [ ! -f "$exe" ]; then
        ps1="$here/sonara-bootstrap.ps1"
        lockw="$lock"
        if command -v cygpath >/dev/null 2>&1; then
            ps1="$(cygpath -w "$ps1")"
            lockw="$(cygpath -w "$lock")"
        fi
        env -u PSModulePath powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass \
            -File "$ps1" -Version "$ver" -Lock "$lockw" -NoStart
    elif [ -n "$own" ]; then
        rm -rf "$lock"
    fi
    if [ ! -f "$exe" ]; then
        echo "Sonara: the runtime could not be installed; see the log in %LOCALAPPDATA%\Sonara\logs\bootstrap.log." >&2
        exit 1
    fi
fi
exec "$exe" "$@"
