#!/usr/bin/env bash
# Sonara's Claude Code hook launcher (#202). It needs nothing but bash: Git
# Bash on Windows, the system /bin/bash (3.2) on macOS.
#
# hooks/hooks.json runs `bin/sonara-hook-launch <Event>` (Claude Code runs
# hook commands through Git Bash on Windows). The runtime this plugin
# version needs (bin/runtime-version) lives in <base>/runtime/<version>/,
# where <base> is %LOCALAPPDATA%\Sonara on Windows and
# ~/Library/Application Support/Sonara on macOS. When it, or a newer
# release, is installed, this execs the newest one's sonara-hook(.exe) with
# the event (bin/sonara-runtime.sh: upgrades go one way); the payload on
# stdin passes through. That path uses shell builtins only (no fork), so a
# hook stays fast. sonara-hook starts sonarad itself when none answers
# (--standalone: it stays up while the plugin is in use).
#
# When none is installed (first use, or a plugin update needs a new
# release), it starts the bootstrap ONCE in the background (a lock folder
# keeps parallel hooks from racing) and exits 0 at once:
# bin/sonara-bootstrap.ps1 on Windows, bin/sonara-bootstrap.sh on macOS.
# The bootstrap downloads the release archive, checks its SHA-256 (and on
# macOS its code signature), installs it and starts the runtime, so the next
# event speaks. A failed bootstrap (offline) is retried by a hook after 5
# minutes. Nothing is installed while Sonara is stopped (<home>/stopped:
# /sonara:stop, uninstall).
# Always exits 0: a hook must never block or fail the Claude session.
here="${0%/*}"
[ "$here" = "$0" ] && here=.
ver=""
{ IFS= read -r ver < "$here/runtime-version"; } 2>/dev/null
ver="${ver%$'\r'}"
case "$OSTYPE" in
darwin*)
    base=""
    [ -n "$HOME" ] && base="$HOME/Library/Application Support/Sonara"
    x=""
    ;;
*)
    lad="${LOCALAPPDATA//\\//}"
    base=""
    [ -n "$lad" ] && base="$lad/Sonara"
    x=".exe"
    ;;
esac
[ -n "$ver" ] && [ -n "$base" ] || exit 0
root="$base/runtime"
sonara_rt=""
if . "$here/sonara-runtime.sh" 2>/dev/null; then
    sonara_pick_runtime "$root" "$ver" "sonara-hook$x"
elif [ -f "$root/$ver/sonara-hook$x" ]; then
    sonara_rt="$ver"
fi
if [ -n "$sonara_rt" ]; then
    exe="$root/$sonara_rt/sonara-hook$x"
    export SONARA_RUNTIME_ARGS="--standalone${SONARA_RUNTIME_ARGS:+ $SONARA_RUNTIME_ARGS}"
    exec "$exe" "$@"
fi

# --- not installed: start the bootstrap once, in the background ----------
exec </dev/null >/dev/null 2>&1
home="${SONARA_HOME//\\//}"
[ -n "$home" ] || home="$base"
[ -e "$home/stopped" ] && exit 0
mkdir -p "$root" || exit 0
failed="$root/.bootstrap.failed"
if [ -f "$failed" ] && [ -n "$(find "$failed" -mmin -5 2>/dev/null)" ]; then
    exit 0
fi
lock="$root/.bootstrap.lock"
if ! mkdir "$lock" 2>/dev/null; then
    # Another hook's bootstrap is running; one older than 15 minutes was
    # killed and is taken over. Parallel hooks can all see it stale, so the
    # takeover holds a second lock folder and checks again under it: one
    # hook never removes the lock another has just taken.
    [ -n "$(find "$lock" -maxdepth 0 -mmin +15 2>/dev/null)" ] || exit 0
    take="$lock.takeover"
    if ! mkdir "$take" 2>/dev/null; then
        # Held for a moment only: one older than a minute was killed.
        [ -n "$(find "$take" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$take"
        exit 0
    fi
    [ -n "$(find "$lock" -maxdepth 0 -mmin +15 2>/dev/null)" ] && rm -rf "$lock"
    mkdir "$lock" 2>/dev/null
    took=$?
    rmdir "$take"
    [ "$took" = 0 ] || exit 0
fi
if [ -z "$x" ]; then
    # macOS: a double fork with nohup, so the bootstrap is no child of the
    # hook and outlives the session's end (it removes the lock when done).
    ( nohup /bin/bash "$here/sonara-bootstrap.sh" --version "$ver" --lock "$lock" & )
    exit 0
fi
ps1="$here/sonara-bootstrap.ps1"
if command -v cygpath >/dev/null 2>&1; then
    ps1="$(cygpath -w "$ps1")"
    lock="$(cygpath -w "$lock")"
fi
# A PowerShell 7 PSModulePath breaks Windows PowerShell's own modules.
# -WindowStyle Hidden: no console flashes up, even where the hook's own
# console is visible.
env -u PSModulePath powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden \
    -ExecutionPolicy Bypass -File "$ps1" -Version "$ver" -Lock "$lock" &
exit 0
